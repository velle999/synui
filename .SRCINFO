	optdepends = cups: find and set up network printers (synui-printers)
	optdepends = avahi: the mDNS announcements network printers and shares make
	optdepends = kitty: the terminal SynapseOS defaulted to before syntty — add it if you want it; every synuirc written between synui 215 and 358 still names it, and anim.c draws it on glass
	optdepends = foot: a second terminal from a different codebase, so a bug that stops syntty opening still leaves a way to get a prompt — the `term` keybind falls back to it
	optdepends = openrgb: put the desktop accent on RGB hardware (syn-rgb)
	optdepends = espeak-ng: the voice the screen reader falls back to where vibe is not installed (syn-speak)
	optdepends = xorg-xcursorgen: build cursor themes from source (synui-cursor build)
	optdepends = syn-arcade: pick a source and play from a library in the music widget
	optdepends = imagemagick: same — most cursor makefiles render their PNGs with it
	optdepends = sound-theme-freedesktop: samples for the Super+S event sounds
	optdepends = libcanberra: XDG sound-theme lookup for the event sounds
	optdepends = ocean-sound-theme: extra sound theme for the Super+S picker (Plasma)
	optdepends = sound-theme-elementary: extra sound theme for the Super+S picker
	optdepends = pop-sound-theme: extra sound theme for the Super+S picker
	optdepends = deepin-sound-theme: extra sound theme for the Super+S picker
	optdepends = synfiles: SynapseOS file manager — the default for the Files button and folder handling
	optdepends = dolphin: file manager, the KDE one; no longer the default
	optdepends = nautilus: file manager, alternative to synfiles
	optdepends = thunar: file manager, alternative to synfiles
	optdepends = wine: run Windows .exe/.msi from the file manager (Run with Wine service menu)
	optdepends = mangohud: in-game FPS/temp overlay, any launcher (Shift_R+F12)
	optdepends = lib32-mangohud: same overlay for 32-bit Vulkan titles
	optdepends = gamemode: CPU/GPU governor for synui-game-run (gamemoderun)
	optdepends = gamescope: nesting micro-compositor for synui-game-run --gamescope
	optdepends = fprintd: unlock the lock screen AND log in with a fingerprint,\n and enrol one in syn-settings ▸ Fingerprint
	backup = etc/MangoHud.conf
	backup = etc/synapseos/mangohud.conf
	source = synui-0.1.0.tar.gz::https://github.com/velle999/synui/releases/download/0.1.0-602/synui-0.1.0.tar.gz
	sha256sums = SKIP

pkgname = synui
